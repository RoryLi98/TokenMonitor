<Window x:Class="TokenMonitor.App.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TokenMonitor 任务栏文本条"
        Width="142"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开详情" Click="OpenMenuItem_Click" />
            <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
            <Separator />
            <MenuItem Header="任务栏显示设置…" Click="SettingsMenuItem_Click" />
            <MenuItem Header="自动选择空白位置" Click="AutoPlaceMenuItem_Click" />
            <MenuItem Header="隐藏任务栏文本条" Click="HideMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出 TokenMonitor" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Cursor="SizeAll"
          ToolTip="{Binding TaskbarTooltip}"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid x:Name="TwoLineTextRoot"
              Background="#01000000"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextHintingMode="Fixed"
              TextOptions.TextRenderingMode="ClearType">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TwoLineLabelColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLinePercentColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLinePrimaryGapColumn" Width="0" />
                <ColumnDefinition x:Name="TwoLineCountdownPrefixColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLineCountdownColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLineWeeklyGapColumn" Width="0" />
                <ColumnDefinition x:Name="TwoLineWeeklyLabelColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLineWeeklyPercentColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLineWeeklyCountdownGapColumn" Width="0" />
                <ColumnDefinition x:Name="TwoLineWeeklyCountdownTextColumn" Width="Auto" />
                <ColumnDefinition x:Name="TwoLineWeeklyCountdownColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CodexTaskbarLabel"
                       Grid.Row="0"
                       Text="Codex"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarPercent"
                       Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding Codex.PercentText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarCountdownPrefix"
                       Grid.Row="0"
                       Grid.Column="3"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarCountdown"
                       Grid.Row="0"
                       Grid.Column="4"
                       Text="{Binding Codex.TaskbarCountdownText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarWeeklyLabel"
                       Grid.Row="0"
                       Grid.Column="6"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarWeeklyPercent"
                       Grid.Row="0"
                       Grid.Column="7"
                       Text="{Binding Codex.TaskbarSecondaryPercentText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarWeeklyResetText"
                       Grid.Row="0"
                       Grid.Column="9"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CodexTaskbarWeeklyCountdown"
                       Grid.Row="0"
                       Grid.Column="10"
                       Text="{Binding Codex.TaskbarSecondaryCountdownText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="ClaudeTaskbarLabel"
                       Grid.Row="1"
                       Text="Claude"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarPercent"
                       Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Claude.PercentText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarCountdownPrefix"
                       Grid.Row="1"
                       Grid.Column="3"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarCountdown"
                       Grid.Row="1"
                       Grid.Column="4"
                       Text="{Binding Claude.TaskbarCountdownText}"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarWeeklyLabel"
                       Grid.Row="1"
                       Grid.Column="6"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarWeeklyPercent"
                       Grid.Row="1"
                       Grid.Column="7"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarWeeklyResetText"
                       Grid.Row="1"
                       Grid.Column="9"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ClaudeTaskbarWeeklyCountdown"
                       Grid.Row="1"
                       Grid.Column="10"
                       Foreground="#000000"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Normal"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
