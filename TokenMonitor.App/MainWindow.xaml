<Window x:Class="TokenMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TokenMonitor"
        Width="280"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="#D9DEE8" />
            <Setter Property="Background" Value="#242830" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343A46" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#2B3039" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Track" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupBorder"
            Background="#FF14171C"
            BorderBrush="#353B46"
            BorderThickness="1"
            CornerRadius="0"
            Padding="7,7,7,2"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PopupHeader" Grid.Row="0" Margin="1,0,1,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo"
                       Width="22"
                       Height="22"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"
                       Source="/TokenMonitor;component/Assets/logo.png" />
                <TextBlock x:Name="HeaderTitle"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="TokenMonitor"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#F4F6FA"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButton}"
                            Command="{Binding RefreshCommand}"
                            Content="↻"
                            ToolTip="立即刷新" />
                    <Button x:Name="HideButton"
                            Style="{StaticResource IconButton}"
                            Click="CloseButton_Click"
                            Content="×"
                            ToolTip="隐藏到系统托盘" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Providers}" AlternationCount="2">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Margin" Value="0,0,0,5" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6"
                                Background="#20242B"
                                BorderBrush="#303640"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#F2F4F8"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ResetText}"
                                                   Margin="9,1,0,0"
                                                   Foreground="#A4ACBA"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="8,-2,0,0"
                                                   Text="{Binding PercentText}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="20"
                                                   FontWeight="Bold" />
                                    </Grid>

                                    <ProgressBar Grid.Row="1"
                                                 Margin="0,6,0,5"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Foreground="{Binding Accent}"
                                                 Style="{StaticResource QuotaProgress}" />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       Foreground="#8E98A9"
                                                       FontSize="9.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SecondaryText}"
                                                   Foreground="#8E98A9"
                                                   FontSize="9.5"
                                                   Visibility="{Binding HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</Window>
