<Window x:Class="TokenMonitor.App.TaskbarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏显示设置"
        Width="416"
        Height="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="显示内容">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="显示内容" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <CheckBox x:Name="ShowPercentCheckBox" Margin="0,0,16,4" Content="显示 5h 剩余额度" />
                                    <CheckBox x:Name="ShowCountdownCheckBox" Margin="0,0,16,4" Content="显示 5h 刷新时间" />
                                    <CheckBox x:Name="ShowWeeklyQuotaCheckBox" Margin="0,0,0,4" Content="显示周额度与刷新时间" />
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Codex" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="5h 剩余额度" />
                                <TextBox x:Name="CodexLabelTextBox" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="5h 刷新时间" />
                                <TextBox x:Name="CodexCountdownPrefixTextBox" Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="周剩余额度" />
                                <TextBox x:Name="CodexWeeklyRemainingTextBox" Grid.Row="4" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="周刷新时间" />
                                <TextBox x:Name="CodexWeeklyResetTextBox" Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center" />

                                <Separator Grid.Row="6" Grid.ColumnSpan="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Claude" />
                                <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="5h 剩余额度" />
                                <TextBox x:Name="ClaudeLabelTextBox" Grid.Row="8" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="5h 刷新时间" />
                                <TextBox x:Name="ClaudeCountdownPrefixTextBox" Grid.Row="9" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="周剩余额度" />
                                <TextBox x:Name="ClaudeWeeklyRemainingTextBox" Grid.Row="10" Grid.Column="1" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="11" VerticalAlignment="Center" Text="周刷新时间" />
                                <TextBox x:Name="ClaudeWeeklyResetTextBox" Grid.Row="11" Grid.Column="1" VerticalContentAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,10,0,0" Header="字体" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="字体名称" />
                                <TextBox x:Name="FontFamilyTextBox" Grid.Column="1" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="字号(pt)" />
                                <TextBox x:Name="FontSizeTextBox" Grid.Column="3" VerticalContentAlignment="Center" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="布局">
                <StackPanel Margin="12">
                    <CheckBox x:Name="LockTaskbarCheckBox"
                              Margin="2,2,0,8"
                              Content="固定任务栏文本条位置" />
                    <TextBlock Margin="2,0,0,10"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Text="固定后不能拖动，并禁用文本条右键菜单；可从托盘图标右键菜单取消固定。" />
                    <GroupBox Header="任务栏布局参数" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="项目间距" />
                            <TextBox x:Name="ItemSpacingTextBox" Grid.Column="1" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="0–32 px" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="垂直间距" />
                            <TextBox x:Name="VerticalMarginTextBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="-10–10 px" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="窗口顶部偏移" />
                            <TextBox x:Name="WindowOffsetTopTextBox" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="-20–20 px" />
                            <TextBlock Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Margin="0,7,0,0"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"
                                       Text="双行窗口固定为 32 px、每行 16 px；垂直间距会让第一行上移、第二行下移。" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Padding="12,5" HorizontalAlignment="Left" Content="恢复默认设置" Click="RestoreDefaultsButton_Click" />
            <Button Grid.Column="1" MinWidth="72" Padding="12,5" IsCancel="True" Content="取消" />
            <Button Grid.Column="3" MinWidth="72" Padding="12,5" IsDefault="True" Content="保存" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
